{
  "name": "moneyflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "collect": "node scripts/collect-once.mjs",
    "db:status": "node scripts/db-status.mjs",
    "check:api": "node scripts/check-api.mjs",
    "collect:stocks": "node scripts/collect-stocks-once.mjs",
    "collect:turnover": "node scripts/collect-turnover-once.mjs",
    "docker:build": "docker build -t moneyflow:local .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f moneyflow",
    "test": "node --test tests/pipeline.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
