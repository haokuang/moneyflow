# 宿主机访问端口
MONEYFLOW_PORT=4173

# 后台采集配置
COLLECT_INTERVAL_MS=60000
BOARD_TYPES=industry,concept
BOARDS_PER_SIDE=15
FETCH_CONCURRENCY=6
