# 宿主机访问端口
MONEYFLOW_PORT=4173

# 后台采集配置
COLLECT_INTERVAL_MS=60000
BOARD_TYPES=industry,concept
BOARDS_PER_SIDE=15
FETCH_CONCURRENCY=6
REQUEST_TIMEOUT_MS=10000

# 个股历史采集：每5分钟回补完整当日1分钟资金流
STOCK_HISTORY_ENABLED=1
STOCK_COLLECT_INTERVAL_MS=300000
STOCK_STARTUP_DELAY_MS=15000
STOCK_BOARD_TYPES=industry
STOCK_BOARDS_PER_TYPE=30
STOCKS_PER_BOARD=5
STOCK_FETCH_CONCURRENCY=4

# A股成交额：首次回补30个交易日，之后只刷新缺失日和最新日
MARKET_TURNOVER_ENABLED=1
MARKET_TURNOVER_COLLECT_INTERVAL_MS=600000
MARKET_TURNOVER_STARTUP_DELAY_MS=5000
MARKET_TURNOVER_DAYS=30
MARKET_TURNOVER_FETCH_CONCURRENCY=4
